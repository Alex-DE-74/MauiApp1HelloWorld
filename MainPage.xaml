<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidJumpUp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <Image
                Source="LilaElinaUndMalva.png"
                SemanticProperties.Description="Cute dot net bot waving hi to you!"
                HeightRequest="200"
                HorizontalOptions="Center" />

            <Label
                Text="Hello, World!"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                Text="Welcome to .NET Multi-platform App UI"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I"
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                x:Name="TestBtnExercises"
                Text="Training Exercises Test"
                SemanticProperties.Hint="Click for navigate to test page"
                Clicked="OnTestExcercisesClicked"
                HorizontalOptions="Center" />

              <Button
                x:Name="TestBtnExcercisesPlan"
                Text="Training Excercises Plan Test"
                SemanticProperties.Hint="Click for navigate to test page"
                Clicked="OnTestExcerisesPlanClicked"
                HorizontalOptions="Center" />

            <Button
                x:Name="CounterBtn"
                Text="Click me"
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Center" />

              <Button
                x:Name="ChallengeBtn"
                Text="Start Challenge"
                SemanticProperties.Hint="Shake your device 10 times"
                Clicked="OnChallengeClicked"
                HorizontalOptions="Center" />
<!-- Ermöglicht dem Nutzer das Auswählen der Uhrzeit -->
<TimePicker 
    x:Name="MeinTimePicker"
    Time="07:00:00"
    Format="HH:mm"
    HorizontalOptions="Center" />

<!-- Der Button, der den ausgewählten Wecker aktiviert -->
<Button
    x:Name="AlarmBtn"
    Text="Wecker stellen"
    Clicked="OnAlarmStellenClicked"
    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
