<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KidJumpUp.Pages.ExercisesPage"
    Title="Übungen">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto">

        <!-- Kopf -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,15">

            <Label
                Grid.Column="0"
                Text="Übungen"
                FontSize="28"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="+ Übung"
                FontSize="18"
                Clicked="OnAddExerciseClicked"
                VerticalOptions="Center" />

        </Grid>


        <!-- Übungen -->
        <CollectionView
            x:Name="ExercisesCollection"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid
                        Padding="0,8"
                        ColumnDefinitions="Auto,*,Auto,Auto">

                        <!-- Aktiv -->
                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{Binding IsActive}"
                            CheckedChanged="OnActiveChanged"
                            VerticalOptions="Center" />

                        <!-- Name -->
                        <Label
                            Grid.Column="1"
                            Text="{Binding Name}"
                            FontSize="20"
                            VerticalOptions="Center"
                            Margin="10,0" />

                        <!-- Bearbeiten -->
                        <Button
                            Grid.Column="2"
                            Text="✎"
                            FontSize="24"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Padding="6,2"
                            Margin="0,0,8,0"
                            Clicked="OnEditExerciseClicked"
                            CommandParameter="{Binding .}"
                            VerticalOptions="Center" />

                        <!-- Löschen -->
                        <Button
                            Grid.Column="3"
                            Text="🗑"
                            FontSize="22"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Padding="6,2"
                            Clicked="OnDeleteExerciseClicked"
                            CommandParameter="{Binding .}"
                            VerticalOptions="Center" />
                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- Floating Editor -->
        <Grid
            x:Name="ExerciseEditorOverlay"
            Grid.RowSpan="3"
            BackgroundColor="#80000000"
            IsVisible="False"
            ZIndex="10">

            <Border
                BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}"
                StrokeThickness="0"
                Padding="20"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout
                    Spacing="15">

                    <Label
                        x:Name="EditorTitle"
                        Text="Neue Übung"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="ExerciseNameEntry"
                        Placeholder="Name der Übung"
                        FontSize="18"
                        ReturnType="Done" />

                    <HorizontalStackLayout
                        HorizontalOptions="End"
                        Spacing="10">

                        <Button
                            Text="Abbrechen"
                            Clicked="OnCancelExerciseClicked" />

                        <Button
                            Text="Speichern"
                            Clicked="OnSaveExerciseClicked" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
