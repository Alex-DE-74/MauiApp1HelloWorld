<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KidJumpUp.Controls"
    xmlns:behaviors="clr-namespace:KidJumpUp.Behaviors"
    x:Class="KidJumpUp.Pages.ExercisePlanItemView">

    <Grid
        Padding="{Binding Source={StaticResource AppConfig}, Path=ExerciseRowPadding, Mode=OneWay}"
        ColumnDefinitions="Auto,*,Auto,Auto,Auto">

        <CheckBox
            Grid.Column="0"
            IsChecked="{Binding IsSelected}"
            VerticalOptions="Center" />

        <Label
            Grid.Column="1"
            Text="{Binding Name}"
            FontSize="{Binding Source={StaticResource AppConfig}, Path=ExerciseFontSize, Mode=OneWay}"
            VerticalOptions="Center"
            Margin="10,0" />

        <controls:NullableIntEntry
            Grid.Column="2"
            Value="{Binding Target, Mode=TwoWay}"
            Placeholder="Zlll"
            TextColor="Black"
            PlaceholderColor="{Binding Source={StaticResource AppConfig}, Path=ExerciseTargetPlaceholderColor, Mode=OneWay}"
            FontSize="{Binding Source={StaticResource AppConfig}, Path=ExerciseTargetFontSize, Mode=OneWay}"
            WidthRequest="80"
            HorizontalTextAlignment="Center"
            VerticalOptions="Center"
            IsEnabled="{Binding IsSelected}">

            <!-- controls:NullableIntEntry.Behaviors>
                <behaviors:FocusOnTrueBehavior
                    Trigger="{Binding IsSelected, Mode=OneWay}" />
            </controls:NullableIntEntry.Behaviors -->

        </controls:NullableIntEntry>

        <controls:NullableIntEntry
            Grid.Column="3"
            Value="{Binding Target, Mode=TwoWay}"
            Placeholder="Zlll"
            FontSize="30"
            WidthRequest="80"
            HorizontalTextAlignment="Center"
            IsEnabled="{Binding IsSelected}"
            VerticalOptions="Center">
            
            <!-- controls:NullableIntEntry.Behaviors>
                <behaviors:FocusOnTrueBehavior
                    Trigger="{Binding IsSelected, Mode=OneWay}" />
            </controls:NullableIntEntry.Behaviors -->

        </controls:NullableIntEntry>

        <Entry
            Grid.Column="4"
            Placeholder="Zlll"
            FontSize="30"
            WidthRequest="80"
            HorizontalTextAlignment="Center"
            IsEnabled="{Binding IsSelected}"
            VerticalOptions="Center">
            
            <!-- controls:NullableIntEntry.Behaviors>
                <behaviors:FocusOnTrueBehavior
                    Trigger="{Binding IsSelected, Mode=OneWay}" />
            </controls:NullableIntEntry.Behaviors -->

        </Entry>

    </Grid>

</ContentView>
