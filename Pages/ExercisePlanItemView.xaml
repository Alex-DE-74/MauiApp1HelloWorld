<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KidJumpUp.Controls"
    xmlns:behaviors="clr-namespace:KidJumpUp.Behaviors"
    x:Class="KidJumpUp.Pages.ExercisePlanItemView">

    <Grid
        Padding="0,8"
        ColumnDefinitions="Auto,*,Auto">

        <CheckBox
            x:Name="SelectionCheckBox"
            Grid.Column="0"
            IsChecked="{Binding IsSelected}"
            CheckedChanged="OnCheckedChanged"
            VerticalOptions="Center" />

        <Label
            Grid.Column="1"
            Text="{Binding Name}"
            FontSize="20"
            VerticalOptions="Center"
            Margin="10,0" />

        <controls:NullableIntEntry
    Grid.Column="2"
    Value="{Binding Target, Mode=TwoWay}"
    Placeholder="Ziel"
    WidthRequest="80"
    HorizontalTextAlignment="Center"
    VerticalOptions="Center"
    IsEnabled="{Binding IsSelected}">

    <controls:NullableIntEntry.Behaviors>
        <behaviors:FocusOnTrueBehavior
            Trigger="{Binding IsSelected, Mode=OneWay}" />
    </controls:NullableIntEntry.Behaviors>

</controls:NullableIntEntry>

    </Grid>

</ContentView>
