<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KidJumpUp.Pages.ExercisePlanPage"
    Title="Planen">

    <Shell.TitleView>
        <Grid
            ColumnDefinitions="*,Auto"
            Padding="0,0,8,0">

            <!-- Page-Titel -->
            <Label
                Grid.Column="0"
                Text="Planen"
                FontSize="20"
                TextColor="{AppThemeBinding
                    Light=White,
                    Dark=White}"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <!-- Speichern -->
            <Button
                Grid.Column="1"
                Text="Speichern"
                FontSize="18"
                FontAttributes="Bold"
                Padding="10,5"
                Margin="0,0,8,0"
                BackgroundColor="{AppThemeBinding
                    Light=#F2F2F2,
                    Dark=#303030}"
                BorderColor="{AppThemeBinding
                    Light=#B8B8B8,
                    Dark=#666666}"
                BorderWidth="1"
                CornerRadius="6"
                TextColor="{AppThemeBinding
                    Light=#222222,
                    Dark=#FFFFFF}"
                Clicked="OnSaveClicked"
                VerticalOptions="Center" />

        </Grid>
    </Shell.TitleView>


    <Grid
        Padding="20"
        RowDefinitions="Auto,*">

        <!-- Kopfbereich -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                Margin="0,8,0,0">

                <Button
                    Grid.Column="0"
                    Text="◀"
                    Clicked="OnPreviousDayClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        x:Name="DayTitleLabel"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="DateLabel"
                        FontSize="14"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="▶"
                    Clicked="OnNextDayClicked" />

            </Grid>

        <!-- Übungen -->
        <CollectionView
            x:Name="ExercisesCollection"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid
                        Padding="0,8"
                        ColumnDefinitions="Auto,*,Auto">

                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{Binding IsSelected}"
                            CheckedChanged="OnExerciseCheckedChanged"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding Name}"
                            FontSize="20"
                            VerticalOptions="Center"
                            Margin="10,0" />

                        <Entry
                            Grid.Column="2"
                            Text="{Binding TargetText}"
                            Keyboard="Numeric"
                            Placeholder="Ziel"
                            WidthRequest="80"
                            HorizontalTextAlignment="Center"
                            VerticalOptions="Center"
                            IsEnabled="{Binding IsSelected}"
                            TextChanged="OnTargetTextChanged" />

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
